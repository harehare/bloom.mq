# A Bloom filter: a compact set that can say "definitely not in the set" or "probably in the set".
#
# The filter is a plain array: [bits, hashes, adds, word, word, ...]. The bits live 32 to a word, and
# each item sets `hashes` of them, chosen from its SHA-256 digest by double hashing.

def _word_count(bits): ceil(bits / 32);

# Reads a hexadecimal string as a number.
def _hex_to_number(hex): fold(explode(hex), 0, fn(acc, cp): acc * 16 + (if (cp < 58): cp - 48 else: cp - 87););

# Returns the two base hashes of an item, the second one odd.
def _base_hashes(item):
  let digest = sha256(to_string(item))
  | let h2 = _hex_to_number(digest[8:16])
  | [_hex_to_number(digest[0:8]), h2 + 1 - h2 % 2]
end

# Returns the filter's bit positions for an item.
def _positions(item, bits, hashes):
  let h = _base_hashes(item)
  | map(range(0, hashes - 1), fn(i): (h[0] + i * h[1]) % bits;)
end

# Returns an empty filter of `bits` bits that sets `hashes` bits per item.
def new(bits, hashes):
  if (bits < 1 || hashes < 1):
    error("bloom: bits and hashes must be at least 1")
  else:
    do
      var a = [bits, hashes, 0]
      | var i = 0
      | let n = _word_count(bits)
      | let _ = while (i < n):
          a += [0]
          | i = i + 1
        end
      | a
    end
end

# Returns an empty filter sized to hold `capacity` items at a false positive rate of about
# `error_rate`, for example 1000 and 0.01.
def for_capacity(capacity, error_rate):
  if (capacity < 1 || error_rate <= 0 || error_rate >= 1):
    error("bloom: capacity must be at least 1 and error rate between 0 and 1")
  else:
    do
      let bits = ceil(-capacity * ln(error_rate) / (ln(2) * ln(2)))
      | new(bits, max(1, round(bits / capacity * ln(2))))
    end
end

# Returns the number of bits.
def bits(bf): bf[0];

# Returns the number of bits set per item.
def hashes(bf): bf[1];

# Returns how many items were added, counting an item again each time it is added.
def count(bf): bf[2];

# Adds an item. Items are compared by the string `to_string` gives for them.
def add(bf, item):
  var a = bf
  | let m = a[0]
  | let pos = _positions(item, m, a[1])
  | var i = 0
  | let _ = while (i < len(pos)):
      let w = 3 + floor(pos[i] / 32)
      | let mask = shift_left(1, pos[i] % 32)
      | let word = a[w]
      | let _ = if (floor(word / mask) % 2 == 0): a[w] = word + mask else: None
      | i = i + 1
    end
  | a[2] = a[2] + 1
  | a
end

# Adds every item of an array.
def add_all(bf, items):
  var a = bf
  | var i = 0
  | let _ = while (i < len(items)):
      a = add(a, items[i])
      | i = i + 1
    end
  | a
end

# Returns true if the item may have been added, and false if it certainly was not.
def contains(bf, item):
  let pos = _positions(item, bf[0], bf[1])
  | var i = 0
  | var found = true
  | let _ = while (found && i < len(pos)):
      found = floor(bf[3 + floor(pos[i] / 32)] / shift_left(1, pos[i] % 32)) % 2 == 1
      | i = i + 1
    end
  | found
end

# Returns the fraction of bits that are set.
def fill_ratio(bf):
  var set_bits = 0
  | var w = 3
  | let _ = while (w < len(bf)):
      var word = bf[w]
      | var b = 0
      | let _ = while (word > 0):
          set_bits = set_bits + word % 2
          | word = floor(word / 2)
        end
      | w = w + 1
    end
  | set_bits / bf[0]
end

# Returns the false positive rate to expect from the bits that are set now.
def estimated_error_rate(bf): pow(fill_ratio(bf), bf[1]);

# Returns a filter holding the items of both, which must have the same number of bits and hashes.
def union(a, b):
  if (a[0] != b[0] || a[1] != b[1]):
    error("bloom: filters differ in size or hashes")
  else:
    do
      var out = a
      | var w = 3
      | let _ = while (w < len(a)):
          var other = b[w]
          | var mask = 1
          | var merged = out[w]
          | let _ = while (other > 0):
              merged = merged + if (other % 2 == 1 && floor(merged / mask) % 2 == 0): mask else: 0
              | other = floor(other / 2)
              | mask = mask * 2
            end
          | out[w] = merged
          | w = w + 1
        end
      | out[2] = a[2] + b[2]
      | out
    end
end
